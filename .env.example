# Required: random string (>= 32 chars) used to encrypt OAuth tokens. Generate with: openssl rand -hex 32
TOKEN_SECRET=

# Optional: public URL of this server, if it can't be derived from the request
# PUBLIC_URL=https://taiga-mcp.example.com

# Optional: instance pre-filled in the login form
# TAIGA_DEFAULT_URL=https://taiga.mycompany.com

# Optional: lock the server to a single Taiga instance (company deployment)
# TAIGA_LOCKED_URL=https://taiga.mycompany.com

# Optional: sign-in methods offered, comma-separated: password, ldap, token (default: password,token)
# TAIGA_AUTH_MODES=password,token

# Optional: only accept https redirect_uris on these hosts (comma-separated). Loopback stays allowed.
# Exact host match: no wildcards, no port, IDN hosts in punycode form.
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# Testing only: allow http:// and private-network instances
# ALLOW_INSECURE_URLS=1
